generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  Unassigned
  Bookkeeper
  InterventionTeam
  Admin
}

/// The single Google account authorised to manage the shared document folder.
model GoogleDriveIntegration {
  id                    Int      @id @default(1)
  encryptedRefreshToken String
  accountEmail          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}
