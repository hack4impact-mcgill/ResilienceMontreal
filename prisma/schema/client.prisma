model Client {
  id           Int       @id @default(autoincrement())
  firstName    String
  lastName     String
  dateOfBirth  DateTime
  workerId     String
  email        String?   @unique
  phone        String?
  landlordName String?
  leaseStart   DateTime?
  leaseEnd     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  worker       User      @relation(fields: [workerId], references: [supabaseId])
}
