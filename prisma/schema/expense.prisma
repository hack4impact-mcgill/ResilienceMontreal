model Expense {
  id              Int                     @id @default(autoincrement())
  totalAmount     Decimal                 @db.Decimal(10, 2)
  description     String
  date            DateTime                @default(now())
  invoiceUrl      String?
  distributions ExpenseDistribution[]
}

model ExpenseDistribution {
  id         Int      @id @default(autoincrement())
  expenseId  Int
  grantDistributionId Int
  amount     Decimal  @db.Decimal(10, 2)
  expense    Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  grantDistribution   GrantDistribution @relation(fields: [grantDistributionId], references: [id])

  @@unique([expenseId, grantDistributionId])
  @@index([grantDistributionId])
}
