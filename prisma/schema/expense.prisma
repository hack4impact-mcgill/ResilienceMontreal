model Expense {
    id            Int                @id @default(autoincrement())
    distributions ExpenseDistribution[]
    totalAmount   Decimal            @db.Decimal(10, 2)
    description   String
    date          DateTime           @default(now())
    invoiceUrl    String?
}

model ExpenseDistribution {
    id         Int      @id @default(autoincrement())
    expenseId  Int
    fundPoolId Int
    amount     Decimal  @db.Decimal(10, 2)  // Amount taken from this specific fund pool
    
    expense    Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
    fundPool   FundPool @relation(fields: [fundPoolId], references: [id])
    
    @@unique([expenseId, fundPoolId])
}